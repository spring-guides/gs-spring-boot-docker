pipeline {
    agent any

    stages {
        stage('Hello World') {
            steps {
                echo 'Hello World'
            }
        }

        stage('Checkout') {
            steps {
                echo 'Checking out the code...'
                git branch: 'docker', url: 'https://github.com/PAVANKUMAR4/gs-spring-boot-docker.git'
                echo 'Code checked out successfully.'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the application...'
                sh 'mvn clean package -DskipTests'
                echo 'Application built successfully.'
            }
        } 
    }
}
